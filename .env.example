APP_BASE_URL=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173

# LinkedIn (web OAuth requires a registered HTTPS callback URL)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_VERSION=202610

# Private app access and token encryption (use long random values)
APP_PASSWORD=
APP_SESSION_SECRET=
OAUTH_ENCRYPTION_KEY=

# Vercel Blob adds BLOB_STORE_ID and VERCEL_OIDC_TOKEN when attached.
# Outside Vercel, a BLOB_READ_WRITE_TOKEN can be used instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=
MEDIA_READ_WRITE_TOKEN=

# Meta / Instagram OAuth. Use the selected supported Instagram Login model.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
FACEBOOK_REDIRECT_URI=
FACEBOOK_API_VERSION=v26.0
FACEBOOK_CONFIG_ID=

# X API user OAuth / post creation
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# TikTok Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_VERIFIED_DOMAIN=

# Google OAuth + YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
